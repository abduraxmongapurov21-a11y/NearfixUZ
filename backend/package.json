{
  "name": "nearfix-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "app-review:prepare": "tsx scripts/prepare-app-review-demo.ts",
    "local-runtime:prepare": "tsx scripts/prepare-local-runtime.ts",
    "db:clean-start": "tsx prisma/clean-start.ts",
    "check": "npm run prisma:validate && npm run build",
    "test:otp-security": "tsx scripts/otp-security-tests.ts",
    "test:password-auth": "tsx scripts/password-auth-tests.ts",
    "test:eskiz-provider": "tsx scripts/eskiz-provider-tests.ts",
    "test:admin-account-auth": "tsx scripts/admin-account-auth-tests.ts",
    "test:admin-management": "tsx scripts/admin-management-tests.ts",
    "test:admin-audit-password": "tsx scripts/admin-audit-password-tests.ts",
    "test:auth-api": "tsx scripts/unified-auth-api-tests.ts",
    "test:unified-auth": "tsx scripts/unified-auth-api-tests.ts",
    "test:legal-routes": "tsx scripts/legal-routes-test.ts",
    "test:sprint-b": "tsx scripts/sprint-b-smoke.ts",
    "test:catalog-distance": "tsx scripts/catalog-distance-tests.ts",
    "test:error-handler": "tsx scripts/error-handler-tests.ts",
    "test:store-races": "tsx scripts/store-race-tests.ts",
    "test:guest-public-api": "tsx scripts/guest-public-api-tests.ts",
    "test:worker-application": "tsx scripts/worker-application-tests.ts",
    "test:order-capabilities": "tsx scripts/order-capability-tests.ts",
    "test:order-lifecycle": "tsx scripts/order-lifecycle-tests.ts",
    "test:notification-rating-v1": "tsx scripts/notification-rating-v1-tests.ts",
    "test:order-location": "tsx scripts/order-location-snapshot-tests.ts",
    "test:local-database-guard": "tsx scripts/local-database-guard-tests.ts",
    "test:categories": "tsx scripts/category-stage1-tests.ts",
    "test:categories:integration": "tsx scripts/category-integration-tests.ts"
