{
  "name": "nearfix-mobile",
  "version": "1.0.1",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "i18n:test": "node scripts/test-i18n.mjs",
    "i18n:verify": "node scripts/verify-i18n.mjs",
    "test:worker-location": "node scripts/test-worker-service-location.mjs",
    "test:catalog-distance": "node scripts/test-catalog-distance.mjs",
    "test:client-address-state": "node scripts/test-client-address-state.mjs",
    "test:store-races": "npm --prefix backend run test:store-races",
    "export:android": "expo export --platform android --output-dir dist-test",
    "export:ios": "expo export --platform ios --output-dir dist-test-ios",
    "export:store": "expo export --platform all --output-dir dist-test-store",
    "release:verify": "npm run i18n:verify && npm run i18n:test && npm run test:worker-location && npm run test:catalog-distance && npm run test:client-address-state && npm run test:store-races && npm run lint && npx expo-doctor@latest && npm run export:store && node scripts/verify-mobile-release.mjs",
    "release:verify:ios": "npm run release:verify",
    "release:build": "npx --yes eas-cli@latest build --platform all --profile production",
    "release:build:android": "npx --yes eas-cli@latest build --platform android --profile production",
    "release:build:ios": "npx --yes eas-cli@latest build --platform ios --profile production",
    "release:submit:android": "npx --yes eas-cli@latest submit --platform android --profile production",
    "release:submit:ios": "npx --yes eas-cli@latest submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.14.0",
    "react": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.8.3"
  }
}
