{
  "expo": {
    "name": "NearFIX",
    "slug": "nearfix-mobile",
    "version": "1.0.4",
    "icon": "./assets/images/icon.png",
    "scheme": "nearfix",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FCFD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NearFIX xaritada joriy joylashuvingizni ko'rsatish uchun lokatsiyaga ruxsat kerak."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-yamap-plus",
        {
          "android_useYandexMapKitLite": false,
          "ios_useYandexMapKitLite": false
        }
      ],
      "./plugins/withYamapIosLocale",
      [
        "expo-image-picker",
        {
          "photosPermission": "NearFIX chatda rasm tanlash uchun galereyaga ruxsat kerak.",
          "cameraPermission": "NearFIX chatda rasmga olish uchun kameraga ruxsat kerak.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0F719D",
          "defaultChannel": "default"
        }
      ]
    ],
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "uz.nearfix.app",
      "buildNumber": "2026072607",
      "infoPlist": {
        "NSCameraUsageDescription": "NearFIX chatda rasmga olish uchun kameraga ruxsat kerak.",
        "NSPhotoLibraryUsageDescription": "NearFIX chatda rasm tanlash uchun galereyaga ruxsat kerak.",
        "NSLocationWhenInUseUsageDescription": "NearFIX xaritada joriy joylashuvingizni ko'rsatish uchun lokatsiyaga ruxsat kerak."
      }
    },
    "android": {
      "package": "uz.nearfix.app",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#0F719D"
      }
    },
    "extra": {
      "authEnabled": true,
      "paymentsEnabled": false,
      "eas": {
        "projectId": "cb752bd0-f6d9-4240-9215-7193ac16755a"
      }
    }
  }
}
