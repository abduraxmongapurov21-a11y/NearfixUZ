{
  "cli": {
    "version": "24.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:4000",
        "EXPO_PUBLIC_AUTH_ENABLED": "true",
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "http://10.0.2.2:4000/legal/privacy",
        "EXPO_PUBLIC_TERMS_URL": "http://10.0.2.2:4000/legal/terms"
      }
    },
    "development-ios": {
      "extends": "development",
      "environment": "production",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.0.102:4000",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "http://192.168.0.102:4000/legal/privacy",
        "EXPO_PUBLIC_TERMS_URL": "http://192.168.0.102:4000/legal/terms"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://nearfix-production-backend-wvd6v.ondigitalocean.app",
        "EXPO_PUBLIC_AUTH_ENABLED": "true",
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://nearfix-production-backend-wvd6v.ondigitalocean.app/legal/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://nearfix-production-backend-wvd6v.ondigitalocean.app/legal/terms"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6782775201"
      }
    }
  }
}
